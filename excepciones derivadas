class ErrorFJ(Exception): """Excepción base de la aplicación."""
class DatoInvalidoError(ErrorFJ): """Un dato no cumple las reglas de validación."""
class ParametroFaltanteError(DatoInvalidoError): """Falta un dato obligatorio."""
class ServicioNoDisponibleError(ErrorFJ): """El servicio no está disponible."""
